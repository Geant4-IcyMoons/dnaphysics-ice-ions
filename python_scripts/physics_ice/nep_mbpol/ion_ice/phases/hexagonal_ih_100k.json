{
  "schema_version": 1,
  "phase_id": "hexagonal_ih_100k",
  "name": "hexagonal ice Ih at 100 K and the experimental cell",
  "target_temperature_k": 100.0,
  "structure_registry": "../../../ice_structures/hexagonal_ih_100K_experimental/collision_structures.json",
  "preparation": {
    "pbs_script": "pbs/run_nep_mbpol_hexagonal.pbs",
    "pbs_job_name": "nep_ih_100K",
    "qsub_arguments": ["-q", "gpuq", "-N", "nep_ih_100K", "-l", "walltime=48:00:00", "-v", "HEXAGONAL_PROTOCOL=100K_EXPERIMENTAL", "-J", "0-2"],
    "replicas": 3,
    "seeds": [1000, 2000, 3000],
    "ensemble": "NVT at the experimental cell"
  },
  "validation": {
    "protocol": "python_scripts/physics_ice/process_evidence/ice_structures/validation/HEXAGONAL_ICE.md",
    "implementation": "python_scripts/physics_ice/nep_mbpol/validate_hexagonal_ice.py",
    "decision_required": true
  },
  "density": {
    "value_g_cm3": 0.9334742974038461,
    "definition": "100 K density from the corrected ice-Ih unit-cell volume fit",
    "provenance": {
      "source": "Rottger et al., Acta Crystallographica B 68, 91-100 (2012), Table 1",
      "doi": "10.1107/S0108768111046908"
    }
  }
}
