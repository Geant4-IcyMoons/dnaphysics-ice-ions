# Classical NEP-MB-pol equilibration at the experimental 100 K ice-Ih cell.
#
# prepare_hexagonal_ice_experimental_cell.py fixes the fully periodic cell to
# the H2O ice-Ih volume and c/a ratio derived from Rottger et al. (2012), DOI
# 10.1107/S0108768111046908.  NVT intentionally leaves that cell unchanged;
# pressure is an output that quantifies the NEP-MB-pol/experimental-cell
# mismatch and is not used to change the density.

potential       nep.txt

# Relax atomic coordinates, but not the paper-derived periodic cell.
minimize        fire 1.0e-4 100000

time_step       0.2
velocity        100 seed @VELOCITY_SEED@

# One-nanosecond thermal equilibration at fixed volume and cell shape.
ensemble        nvt_nhc 100 100 200
dump_thermo     10000
dump_exyz       500000 1 0
dump_restart    500000
run             5000000

# One-nanosecond sampling block under identical NVT conditions.
ensemble        nvt_nhc 100 100 200
dump_thermo     10000
dump_exyz       500000 1 0
dump_restart    500000
run             5000000
