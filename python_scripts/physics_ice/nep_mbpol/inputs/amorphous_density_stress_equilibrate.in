# Preliminary NEP-MB-pol compatibility test at a fixed amorphous-ice density.
# The cell is imposed by prepare_amorphous_density_cell.py. Pressure and
# structure are predictions and determine whether the candidate is viable.

potential       nep.txt
minimize        fire 1.0e-4 100000
time_step       0.2
velocity        80 seed @VELOCITY_SEED@
ensemble        nvt_nhc 80 80 200
dump_thermo     10000
dump_exyz       250000 1 0
dump_restart    250000
run             2500000
