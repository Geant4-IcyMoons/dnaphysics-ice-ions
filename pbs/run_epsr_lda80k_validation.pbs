#!/bin/bash
#PBS -N epsr_lda80k
#PBS -q idle
#PBS -l select=1:ncpus=4:mem=2gb
#PBS -l walltime=01:00:00
#PBS -j oe

set -euo pipefail

REPOSITORY="${PBS_O_WORKDIR:-/work/yoffegid/dnaphysics-ice-ions}"
PHYSICS_ICE="${REPOSITORY}/python_scripts/physics_ice"
MODEL="${PHYSICS_ICE}/ice_structures/epsr_lda80k"
SOURCE="${PHYSICS_ICE}/process_evidence/ice_structures/validation/runs/epsr_lda80k/source/LDAneutron"
PLOT_FONTS="${PHYSICS_ICE}/process_evidence/ice_structures/validation/runs/epsr_lda80k/plot_fonts"
PYTHON="${PHYSICS_ICE}/nep_mbpol/.venv/bin/python"
WORKERS="${PBS_NCPUS:-4}"

cd "${REPOSITORY}"
test -x "${PYTHON}"
test -f "${SOURCE}/LDA80K.ato"
test -f "${PLOT_FONTS}/NimbusMonoPS-Regular.otf"

# Each structural observable is an independent process.  Keep numerical
# libraries single-threaded so the process pool does not oversubscribe PBS.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PHYSICS_ICE_PLOT_FONT_DIR="${PLOT_FONTS}"

"${PYTHON}" "${MODEL}/validate.py" \
  --source-dir "${SOURCE}" \
  --output-dir "${MODEL}/artifacts" \
  --workers "${WORKERS}"

"${PYTHON}" "${PHYSICS_ICE}/nep_mbpol/plot_hexagonal_ice_structure.py" \
  --structure "${MODEL}/artifacts/lda80k_epsr.xyz.gz" \
  --output-stem "${MODEL}/artifacts/epsr_lda80k_structure"

"${PYTHON}" "${PHYSICS_ICE}/nep_mbpol/attest_collision_structure.py" \
  "${MODEL}/artifacts/lda80k_epsr.xyz.gz" \
  --phase "low-density amorphous ice, EPSR neutron model, 80 K" \
  --validation-report "${MODEL}/artifacts/epsr_lda80k_validation.json" \
  --confirm-accepted

"${PYTHON}" "${PHYSICS_ICE}/nep_mbpol/register_collision_structures.py" \
  "${MODEL}/artifacts/lda80k_epsr.xyz.gz" \
  --output "${MODEL}/artifacts/collision_structures.json"
