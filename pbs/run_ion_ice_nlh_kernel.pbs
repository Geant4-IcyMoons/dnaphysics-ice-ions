#!/usr/bin/env bash
#PBS -N ion_nlh_kernel
#PBS -q idle
#PBS -l select=1:ncpus=16:mem=4gb
#PBS -l walltime=12:00:00
#PBS -j oe

# Generate and independently benchmark one projectile's two NLH H/O kernels.
# Completed PBS accounting showed approximately 13 simultaneously used cores
# and less than 0.4 GB peak RSS. Sixteen cores/4 GB retains ample headroom.

set -euo pipefail
umask 002

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${REPO_ROOT:-${PBS_O_WORKDIR:-$(cd "${SCRIPT_DIR}/.." && pwd)}}"
REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
cd "${REPO_ROOT}"

NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
PYTHON_BIN="${PYTHON_BIN:-${NEP_DIR}/.venv/bin/python}"
export PYTHONPATH="${NEP_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
PROJECTILE="${PROJECTILE:?Set PROJECTILE to a registered ion symbol.}"
KERNEL_OUTPUT="${KERNEL_OUTPUT:-${NEP_DIR}/collision_kernels/by_species/${PROJECTILE}}"
BENCHMARK_OUTPUT="${BENCHMARK_OUTPUT:-${NEP_DIR}/collision_benchmarks/by_species/${PROJECTILE}}"

if [[ ! -x "${PYTHON_BIN}" ]]; then
    echo "Missing Python interpreter ${PYTHON_BIN}." >&2
    exit 2
fi
"${PYTHON_BIN}" -c \
    'import sys; from ion_ice import get_projectile; p=get_projectile(sys.argv[1]); sys.exit(0 if p.component_status("nlh_pair_potential") == "implemented" else "NLH pair potential is not implemented.")' \
    "${PROJECTILE}"

if [[ -n "${PBS_NCPUS:-}" ]]; then
    ALLOCATED_CPUS="${PBS_NCPUS}"
else
    ALLOCATED_CPUS="$("${PYTHON_BIN}" -c 'import os; print(len(os.sched_getaffinity(0)))')"
fi
WORKERS="${WORKERS:-${ALLOCATED_CPUS}}"
if [[ ! "${WORKERS}" =~ ^[1-9][0-9]*$ || "${WORKERS}" -gt "${ALLOCATED_CPUS}" ]]; then
    echo "WORKERS must lie in 1-${ALLOCATED_CPUS}." >&2
    exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

echo "Projectile: ${PROJECTILE}"
echo "Host: $(hostname)"
echo "Workers: ${WORKERS}"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

"${PYTHON_BIN}" -u "${NEP_DIR}/generate_nlh_collision_kernels.py" \
    --projectiles "${PROJECTILE}" \
    --workers "${WORKERS}" \
    --output-directory "${KERNEL_OUTPUT}"

"${PYTHON_BIN}" -u "${NEP_DIR}/benchmark_nlh_adaptive_kernels.py" \
    --projectiles "${PROJECTILE}" \
    --workers "${WORKERS}" \
    --output-directory "${BENCHMARK_OUTPUT}"

echo "Completed UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
