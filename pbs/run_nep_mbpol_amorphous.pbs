#!/usr/bin/env bash
#PBS -N nep_mbpol_lda
#PBS -q gpuq_private
#PBS -l select=1:ncpus=4:ngpus=1:mem=8gb:node_type=gpu48gb
#PBS -l walltime=500:00:00
#PBS -j oe

# One PBS array element runs one statistically independent amorphous-ice seed
# on one GPU.  Submit the three documented seeds with:
#
#   qsub -J 0-2 pbs/run_nep_mbpol_amorphous.pbs
#
# Array indices 0, 1, and 2 map to seeds 1000, 2000, and 3000.  A single seed
# can instead be selected explicitly:
#
#   qsub -v SEED=1000 pbs/run_nep_mbpol_amorphous.pbs
#
# This job uses the ps-group private GPU queue.  A public-queue submission can
# override the queue and its 120-hour maximum on the qsub command line.

set -euo pipefail
umask 002

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -d "${PBS_O_WORKDIR}/python_scripts/physics_ice/nep_mbpol" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
GPUMD_SOURCE="${NEP_DIR}/upstream/GPUMD-v3.9.3/src"
POTENTIAL="${NEP_DIR}/model/nep-mbpol.nep.txt"
RUN_INPUT="${RUN_INPUT:-${NEP_DIR}/inputs/amorphous_lda_full.in}"
CUDA_MODULE="${CUDA_MODULE:-cuda/12.6}"

if [[ -z "${SEED:-}" ]]; then
    ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-}}"
    case "${ARRAY_INDEX}" in
        0) SEED=1000 ;;
        1) SEED=2000 ;;
        2) SEED=3000 ;;
        *)
            echo "Set SEED, or submit this script with -J 0-2." >&2
            exit 2
            ;;
    esac
fi
if [[ ! "${SEED}" =~ ^[0-9]+$ ]]; then
    echo "SEED must be a non-negative integer; got: ${SEED}" >&2
    exit 2
fi

INITIAL_MODEL="${INITIAL_MODEL:-${NEP_DIR}/structures/ice_ih_8x8x8_seed${SEED}_melt_start.xyz}"
RUN_DIR="${RUN_DIR:-${NEP_DIR}/runs/amorphous_seed${SEED}}"

for required in "${GPUMD_SOURCE}/makefile" "${POTENTIAL}" "${RUN_INPUT}" "${INITIAL_MODEL}"; do
    if [[ ! -f "${required}" ]]; then
        echo "Required file is missing: ${required}" >&2
        exit 2
    fi
done

if [[ "$(grep -Fc '@VELOCITY_SEED@' "${RUN_INPUT}")" -ne 1 ]]; then
    echo "Run-input template must contain exactly one @VELOCITY_SEED@ token: ${RUN_INPUT}" >&2
    exit 2
fi

mkdir -p "${RUN_DIR}"
if [[ -e "${RUN_DIR}/COMPLETED" ]]; then
    echo "Seed ${SEED} is already marked complete: ${RUN_DIR}"
    exit 0
fi
if [[ -e "${RUN_DIR}/thermo.out" || -e "${RUN_DIR}/restart.xyz" || -e "${RUN_DIR}/gpumd.log" ]]; then
    echo "Refusing to overwrite an incomplete run in ${RUN_DIR}." >&2
    echo "Continuation requires a run.in with the correct remaining time and temperature ramp." >&2
    exit 2
fi

if ! type module >/dev/null 2>&1; then
    # shellcheck disable=SC1091
    source /etc/profile.d/modules.sh
fi
module load "${CUDA_MODULE}"
command -v nvcc >/dev/null
command -v nvidia-smi >/dev/null

SCRATCH_PARENT="${TMPDIR:-/tmp/${USER}/${PBS_JOBID:-nep-mbpol}}"
BUILD_DIR="${SCRATCH_PARENT}/gpumd-v3.9.3-src"
mkdir -p "${SCRATCH_PARENT}"
cp -a "${GPUMD_SOURCE}" "${BUILD_DIR}"

MAKE_JOBS="${PBS_NCPUS:-4}"
if [[ ! "${MAKE_JOBS}" =~ ^[1-9][0-9]*$ || "${MAKE_JOBS}" -gt 4 ]]; then
    MAKE_JOBS=4
fi

echo "Repository: ${REPO_ROOT}"
echo "Seed: ${SEED}"
echo "Run directory: ${RUN_DIR}"
echo "CUDA module: ${CUDA_MODULE}"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-scheduler-managed}"
nvidia-smi --query-gpu=name,memory.total,compute_cap --format=csv,noheader

# Compile for the GPU allocated to this job.  Building the 6.9 MB source tree
# in node-local scratch avoids login-node compilation and cross-job races.
make -C "${BUILD_DIR}" clean >/dev/null
make -C "${BUILD_DIR}" -j "${MAKE_JOBS}" gpumd \
    CFLAGS='-std=c++14 -O3 -arch=native' \
    >"${RUN_DIR}/build.log" 2>&1
test -x "${BUILD_DIR}/gpumd"

cp "${INITIAL_MODEL}" "${RUN_DIR}/model.xyz"
cp "${POTENTIAL}" "${RUN_DIR}/nep.txt"
sed "s/@VELOCITY_SEED@/${SEED}/" "${RUN_INPUT}" >"${RUN_DIR}/run.in"
if ! grep -Eq "^velocity[[:space:]]+350[[:space:]]+seed[[:space:]]+${SEED}[[:space:]]*$" \
    "${RUN_DIR}/run.in"; then
    echo "Failed to render the explicit velocity seed in ${RUN_DIR}/run.in." >&2
    exit 2
fi

{
    echo "seed=${SEED}"
    echo "structure_seed=${SEED}"
    echo "velocity_seed=${SEED}"
    echo "ensemble=npt_ber"
    echo "target_pressure_gpa=0.0001"
    echo "protocol=adapted_nep_mbpol_candidate_lda_20ns"
    echo "literature_cooling_segment_doi=10.1038/s42004-024-01117-2"
    echo "job_id=${PBS_JOBID:-not-set}"
    echo "host=$(hostname)"
    echo "started_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "cuda_module=${CUDA_MODULE}"
    echo "cuda_visible_devices=${CUDA_VISIBLE_DEVICES:-scheduler-managed}"
    echo "initial_model=${INITIAL_MODEL}"
    sha256sum "${RUN_DIR}/model.xyz" "${RUN_DIR}/nep.txt" "${RUN_DIR}/run.in"
    nvidia-smi --query-gpu=name,uuid,memory.total,compute_cap,driver_version \
        --format=csv,noheader
} >"${RUN_DIR}/provenance.txt"

cd "${RUN_DIR}"
"${BUILD_DIR}/gpumd" >gpumd.log 2>&1

test -s restart.xyz
{
    echo "completed_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    sha256sum restart.xyz thermo.out dump.xyz
} >>provenance.txt
touch COMPLETED
