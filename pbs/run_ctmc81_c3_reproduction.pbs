#!/usr/bin/env bash
#PBS -N c3_ctmc81_nucleus
#PBS -q long
#PBS -l select=1:ncpus=256:mem=64gb
#PBS -l walltime=500:00:00
#PBS -j oe

# Formal, restart-safe reproduction of the user-supplied Liamsuwan CTMC81
# C3+ + H2O primitive probability tables at 100 keV/u. Two independent
# replicas each retain the disclosed per-impact trajectory count. Projectile
# loss uses the CTMC81 screened-nucleus beam-path convention.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/C3_100keVpu.zip" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "${REPO_ROOT}"

CONDA_SH="${CONDA_SH:-/apps01/apps/anaconda3-2022.10/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-yoffe_venv}"
PYTHON_BIN="${PYTHON_BIN:-python}"
REFERENCE_ARCHIVE="${REFERENCE_ARCHIVE:-${REPO_ROOT}/C3_100keVpu.zip}"
OUTPUT_DIR="${OUTPUT_DIR:-${REPO_ROOT}/python_scripts/physics_ice/process_evidence/charge_exchange_ctmc/benchmarking/runs/ctmc81_c3_100keV_u_olson_salop_reproduction}"
REPLICAS="${REPLICAS:-2}"
TRAJECTORY_CHUNK_SIZE="${TRAJECTORY_CHUNK_SIZE:-100}"
TOLERANCE_AUDIT_TRAJECTORIES="${TOLERANCE_AUDIT_TRAJECTORIES:-100}"

# shellcheck disable=SC1090
source "${CONDA_SH}"
conda activate "${CONDA_ENV}"

if [[ -n "${PBS_NCPUS:-}" ]]; then
    WORKERS="${PBS_NCPUS}"
elif [[ -n "${NCPUS:-}" ]]; then
    WORKERS="${NCPUS}"
else
    WORKERS="$(${PYTHON_BIN} -c 'import os; print(len(os.sched_getaffinity(0)))')"
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
if [[ -n "${TMPDIR:-}" ]]; then
    export NUMBA_CACHE_DIR="${TMPDIR}/ctmc81-c3-numba-cache"
    mkdir -p "${NUMBA_CACHE_DIR}"
fi

cmd=(
    "${PYTHON_BIN}" -u
    python_scripts/physics_ice/process_evidence/charge_exchange_ctmc/benchmarking/run_ctmc81_c3_reproduction.py
    --reference-archive "${REFERENCE_ARCHIVE}"
    --output-dir "${OUTPUT_DIR}"
    --workers "${WORKERS}"
    --replicas "${REPLICAS}"
    --trajectory-chunk-size "${TRAJECTORY_CHUNK_SIZE}"
    --tolerance-audit-trajectories "${TOLERANCE_AUDIT_TRAJECTORIES}"
    --rtol 1e-11
    --atol 1e-13
    --retry-rtol 1e-12
    --retry-atol 1e-14
    --maximum-relative-energy-drift 1e-4
    --maximum-integration-steps 100000000
)

echo "Repository: ${REPO_ROOT}"
echo "Reference: ${REFERENCE_ARCHIVE}"
echo "Output: ${OUTPUT_DIR}"
echo "Workers: ${WORKERS}; independent exact replicas: ${REPLICAS}"
printf 'Command:'
printf ' %q' "${cmd[@]}"
printf '\n'

"${cmd[@]}"
