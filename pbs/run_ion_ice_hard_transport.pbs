#!/usr/bin/env bash
#PBS -N ion_nlh_transport
#PBS -q idle
#PBS -l select=1:ncpus=64:mem=16gb
#PBS -l walltime=500:00:00
#PBS -j oe

# Run one projectile/accepted-phase adaptive hard-transport workflow. The
# current 64-core/16-GB allocation is the calibrated production layout.

set -euo pipefail
umask 002

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${REPO_ROOT:-${PBS_O_WORKDIR:-$(cd "${SCRIPT_DIR}/.." && pwd)}}"
REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
cd "${REPO_ROOT}"

NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
PYTHON_BIN="${PYTHON_BIN:-${NEP_DIR}/.venv/bin/python}"
export PYTHONPATH="${NEP_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
PROJECTILE="${PROJECTILE:?Set PROJECTILE to a registered ion symbol.}"
PHASE_ID="${PHASE_ID:?Set PHASE_ID to a registered accepted phase.}"
STRUCTURE_DIRECTORY="${STRUCTURE_DIRECTORY:?Set STRUCTURE_DIRECTORY from the accepted registry.}"
KERNELS="${KERNELS:?Set KERNELS to an accepted kernel product.}"

if [[ ! -x "${PYTHON_BIN}" ]]; then
    echo "Missing Python interpreter ${PYTHON_BIN}." >&2
    exit 2
fi
"${PYTHON_BIN}" - "${PROJECTILE}" "${PHASE_ID}" "${STRUCTURE_DIRECTORY}" <<'PY'
import sys
from pathlib import Path
from ion_ice import get_phase, get_projectile

projectile = get_projectile(sys.argv[1])
phase = get_phase(sys.argv[2])
if projectile.component_status("hard_transport") != "implemented":
    raise SystemExit("Hard transport is not implemented for this projectile.")
registry = phase.resolve(phase.structure_registry)
if registry is None or registry.parent != Path(sys.argv[3]).resolve():
    raise SystemExit("STRUCTURE_DIRECTORY does not match the accepted phase registry.")
PY

if [[ -n "${PBS_NCPUS:-}" ]]; then
    ALLOCATED_CPUS="${PBS_NCPUS}"
else
    ALLOCATED_CPUS="$("${PYTHON_BIN}" -c 'import os; print(len(os.sched_getaffinity(0)))')"
fi
WORKERS="${WORKERS:-${ALLOCATED_CPUS}}"
if [[ ! "${WORKERS}" =~ ^[1-9][0-9]*$ || "${WORKERS}" -gt "${ALLOCATED_CPUS}" ]]; then
    echo "WORKERS must lie in 1-${ALLOCATED_CPUS}." >&2
    exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

cmd=(
    "${PYTHON_BIN}" -u "${NEP_DIR}/adaptive_nlh_particle_transport.py"
    --projectile "${PROJECTILE}"
    --structure-directory "${STRUCTURE_DIRECTORY}"
    --kernels "${KERNELS}"
    --workers "${WORKERS}"
    --tolerance "${TOLERANCE:-0.005}"
    --confidence "${CONFIDENCE:-0.95}"
    --calibration-trajectories "${CALIBRATION_TRAJECTORIES:-10000}"
    --minimum-trajectories "${MINIMUM_TRAJECTORIES:-200000}"
    --maximum-trajectories "${MAXIMUM_TRAJECTORIES:-64000000}"
    --trajectory-batch-size "${TRAJECTORY_BATCH_SIZE:-10000}"
    --maximum-refinement-depth "${MAXIMUM_REFINEMENT_DEPTH:-8}"
    --maximum-energy-points "${MAXIMUM_ENERGY_POINTS:-257}"
)

echo "Projectile/phase: ${PROJECTILE} / ${PHASE_ID}"
echo "Host: $(hostname)"
echo "Workers: ${WORKERS}"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
"${cmd[@]}"
echo "Completed UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
