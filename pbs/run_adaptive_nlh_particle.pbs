#!/usr/bin/env bash
#PBS -N nlh_adaptive
#PBS -q idle
#PBS -l select=1:ncpus=64:mem=16gb
#PBS -l walltime=500:00:00
#PBS -j oe

# One PBS allocation processes one projectile. The `idle` routing queue places
# the job in the route-only `idlex` execution queue.

set -euo pipefail
umask 002

if [[ ! "${PROJECTILE:-}" =~ ^(H|He|C|O|S)$ ]]; then
    echo "PROJECTILE must be one of H, He, C, O, or S." >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/python_scripts/physics_ice/nep_mbpol/adaptive_nlh_particle_transport.py" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "${REPO_ROOT}"

NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
CONTROLLER="${NEP_DIR}/adaptive_nlh_particle_transport.py"
PYTHON_BIN="${PYTHON_BIN:-${NEP_DIR}/.venv/bin/python}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/python_scripts/physics_ice/process_evidence/hard_nuclear_collisions/validation/runs/adaptive_particles}"

if [[ ! -f "${CONTROLLER}" || ! -x "${PYTHON_BIN}" ]]; then
    echo "Missing adaptive controller or its Python interpreter." >&2
    exit 2
fi

if [[ -n "${PBS_NCPUS:-}" ]]; then
    ALLOCATED_CPUS="${PBS_NCPUS}"
elif [[ -n "${NCPUS:-}" ]]; then
    ALLOCATED_CPUS="${NCPUS}"
else
    ALLOCATED_CPUS="$("${PYTHON_BIN}" -c 'import os; print(len(os.sched_getaffinity(0)))')"
fi
WORKERS="${WORKERS:-${ALLOCATED_CPUS}}"
if [[ ! "${WORKERS}" =~ ^[1-9][0-9]*$ || "${WORKERS}" -gt "${ALLOCATED_CPUS}" ]]; then
    echo "WORKERS must lie in 1-${ALLOCATED_CPUS}; got ${WORKERS}." >&2
    exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

cmd=(
    "${PYTHON_BIN}" -u "${CONTROLLER}"
    --projectile "${PROJECTILE}"
    --workers "${WORKERS}"
    --output-root "${OUTPUT_ROOT}"
    --meaningful-significant-digits "${MEANINGFUL_SIGNIFICANT_DIGITS:-2}"
    --interpolation-tolerance "${INTERPOLATION_TOLERANCE:-0.005}"
    --trajectory-cdf-tolerance "${TRAJECTORY_CDF_TOLERANCE:-0.005}"
    --confidence "${CONFIDENCE:-0.95}"
    --calibration-trajectories "${CALIBRATION_TRAJECTORIES:-10000}"
    --minimum-trajectories "${MINIMUM_TRAJECTORIES:-200000}"
    --maximum-trajectories "${MAXIMUM_TRAJECTORIES:-64000000}"
    --trajectory-batch-size "${TRAJECTORY_BATCH_SIZE:-10000}"
    --sampling-mode "${SAMPLING_MODE:-collision_tube_mixture}"
    --tube-mixture-fraction "${TUBE_MIXTURE_FRACTION:-0.5}"
    --maximum-refinement-depth "${MAXIMUM_REFINEMENT_DEPTH:-8}"
    --maximum-energy-points "${MAXIMUM_ENERGY_POINTS:-257}"
)
if [[ -n "${EXTENDED_MAXIMUM_TRAJECTORIES:-}" ]]; then
    cmd+=(--extended-maximum-trajectories "${EXTENDED_MAXIMUM_TRAJECTORIES}")
fi
if [[ "${UNLIMITED_TRAJECTORIES:-0}" == "1" ]]; then
    cmd+=(--unlimited-trajectories)
elif [[ "${UNLIMITED_TRAJECTORIES:-0}" != "0" ]]; then
    echo "UNLIMITED_TRAJECTORIES must be 0 or 1." >&2
    exit 2
fi

echo "Repository: ${REPO_ROOT}"
echo "Commit: $(git rev-parse HEAD)"
echo "Projectile: ${PROJECTILE}"
echo "Host: $(hostname)"
echo "Allocated CPUs: ${ALLOCATED_CPUS}"
echo "Workers: ${WORKERS}"
echo "Meaningful significant digits: ${MEANINGFUL_SIGNIFICANT_DIGITS:-2}"
echo "Interpolation tolerance: ${INTERPOLATION_TOLERANCE:-0.005}"
echo "Trajectory-CDF tolerance: ${TRAJECTORY_CDF_TOLERANCE:-0.005}"
echo "Output root: ${OUTPUT_ROOT}"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'Command:'
printf ' %q' "${cmd[@]}"
printf '\n'

if [[ "${DRY_RUN:-0}" == "1" ]]; then
    "${cmd[@]}" --dry-run
elif [[ "${DRY_RUN:-0}" == "0" ]]; then
    "${cmd[@]}"
else
    echo "DRY_RUN must be 0 or 1." >&2
    exit 2
fi

echo "Completed UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
