#!/usr/bin/env bash
#PBS -N nlh_shard_stage
#PBS -q idle
#PBS -l select=1:ncpus=1:mem=32gb
#PBS -l walltime=12:00:00
#PBS -j oe

# The only writer of adaptive hard-collision state. It reduces a completed
# wave, prepares the next breadth-first energy-refinement wave, submits
# deterministic case shards, and chains itself after all shards succeed.

set -euo pipefail
umask 002

if [[ ! "${PROJECTILE:-}" =~ ^(H|He|C|O|S)$ ]]; then
    echo "PROJECTILE must be one of H, He, C, O, or S." >&2
    exit 2
fi

if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    echo "REPO_ROOT or PBS_O_WORKDIR is required." >&2
    exit 2
fi
cd "${REPO_ROOT}"

PBS_DIR="${REPO_ROOT}/pbs"
NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
PYTHON_BIN="${PYTHON_BIN:-${NEP_DIR}/.venv/bin/python}"
CONTROLLER="${NEP_DIR}/adaptive_nlh_particle_shards.py"
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/python_scripts/physics_ice/process_evidence/hard_nuclear_collisions/validation/runs/sharded_adaptive_particles}"
MAX_GLOBAL_SHARDS="${MAX_GLOBAL_SHARDS:-256}"
MAX_ARRAY_SIZE="${MAX_ARRAY_SIZE:-50}"
CASE_CPUS="${CASE_CPUS:-128}"
CASE_MEMORY_GB="${CASE_MEMORY_GB:-16}"
UNLIMITED_TRAJECTORIES="${UNLIMITED_TRAJECTORIES:-1}"

if [[ ! "${MAX_GLOBAL_SHARDS}" =~ ^[1-9][0-9]*$ \
      || ! "${MAX_ARRAY_SIZE}" =~ ^[1-9][0-9]*$ \
      || ! "${CASE_CPUS}" =~ ^[1-9][0-9]*$ \
      || ! "${CASE_MEMORY_GB}" =~ ^[1-9][0-9]*$ \
      || ! "${UNLIMITED_TRAJECTORIES}" =~ ^[01]$ \
      || "${CASE_CPUS}" -gt 256 || "${CASE_MEMORY_GB}" -gt 512 ]]; then
    echo "Shard limits must be positive integers." >&2
    exit 2
fi

prepare=(
    "${PYTHON_BIN}" -u "${CONTROLLER}" prepare
    --projectile "${PROJECTILE}"
    --output-root "${OUTPUT_ROOT}"
    --tolerance "${TOLERANCE:-0.005}"
    --confidence "${CONFIDENCE:-0.95}"
    --calibration-trajectories "${CALIBRATION_TRAJECTORIES:-10000}"
    --minimum-trajectories "${MINIMUM_TRAJECTORIES:-200000}"
    --maximum-trajectories "${MAXIMUM_TRAJECTORIES:-64000000}"
    --trajectory-batch-size "${TRAJECTORY_BATCH_SIZE:-100000}"
    --sampling-mode "${SAMPLING_MODE:-collision_tube_mixture}"
    --tube-mixture-fraction "${TUBE_MIXTURE_FRACTION:-0.5}"
    --maximum-refinement-depth "${MAXIMUM_REFINEMENT_DEPTH:-8}"
    --maximum-energy-points "${MAXIMUM_ENERGY_POINTS:-257}"
)
if [[ "${UNLIMITED_TRAJECTORIES}" == 1 ]]; then
    if [[ -n "${EXTENDED_MAXIMUM_TRAJECTORIES:-}" ]]; then
        echo "UNLIMITED_TRAJECTORIES=1 conflicts with EXTENDED_MAXIMUM_TRAJECTORIES." >&2
        exit 2
    fi
    prepare+=(--unlimited-trajectories)
elif [[ -n "${EXTENDED_MAXIMUM_TRAJECTORIES:-}" ]]; then
    prepare+=(--extended-maximum-trajectories "${EXTENDED_MAXIMUM_TRAJECTORIES}")
fi
PREPARE_OUTPUT="$("${prepare[@]}")"
printf '%s\n' "${PREPARE_OUTPUT}"
if grep -q '^Completed hard-shard campaign:' <<< "${PREPARE_OUTPUT}"; then
    exit 0
fi
WAVE_MANIFEST="$(sed -n 's/^Prepared wave manifest: //p' <<< "${PREPARE_OUTPUT}")"
CASE_COUNT="$(sed -n 's/^Pending case count: //p' <<< "${PREPARE_OUTPUT}")"
if [[ ! -f "${WAVE_MANIFEST}" || ! "${CASE_COUNT}" =~ ^[1-9][0-9]*$ ]]; then
    echo "Controller did not provide one non-empty wave." >&2
    exit 1
fi

SUBMISSION_LOCK="${WAVE_MANIFEST}.submission"
if ! mkdir "${SUBMISSION_LOCK}" 2>/dev/null; then
    echo "Wave already has a submission owner: ${SUBMISSION_LOCK}"
    exit 0
fi
submission_complete=0
array_jobs=()
cleanup_incomplete_submission() {
    if (( submission_complete == 0 )); then
        for job in "${array_jobs[@]}"; do
            qdel "${job}" 2>/dev/null || true
        done
        rmdir "${SUBMISSION_LOCK}" 2>/dev/null || true
    fi
}
trap cleanup_incomplete_submission EXIT

SHARD_COUNT="${CASE_COUNT}"
if (( SHARD_COUNT > MAX_GLOBAL_SHARDS )); then
    SHARD_COUNT="${MAX_GLOBAL_SHARDS}"
fi
offset=0
while (( offset < SHARD_COUNT )); do
    remaining=$((SHARD_COUNT - offset))
    local_count="${MAX_ARRAY_SIZE}"
    if (( remaining < local_count )); then
        local_count="${remaining}"
    fi
    last_index=$((local_count - 1))
    array_job="$(qsub \
        -N "nlh_${PROJECTILE}_w${offset}" \
        -J "0-${last_index}" \
        -l "select=1:ncpus=${CASE_CPUS}:mem=${CASE_MEMORY_GB}gb" \
        -v "WAVE_MANIFEST=${WAVE_MANIFEST},SHARD_COUNT=${SHARD_COUNT},SHARD_OFFSET=${offset},WORKERS=${CASE_CPUS},REPO_ROOT=${REPO_ROOT}" \
        "${PBS_DIR}/run_adaptive_nlh_particle_shard.pbs")"
    array_jobs+=("${array_job}")
    echo "Submitted ${array_job}: global shards ${offset}-$((offset + local_count - 1))/${SHARD_COUNT}"
    offset=$((offset + local_count))
done

dependency="$(IFS=:; echo "${array_jobs[*]}")"
next_variables="PROJECTILE=${PROJECTILE},REPO_ROOT=${REPO_ROOT},OUTPUT_ROOT=${OUTPUT_ROOT},MAX_GLOBAL_SHARDS=${MAX_GLOBAL_SHARDS},MAX_ARRAY_SIZE=${MAX_ARRAY_SIZE},CASE_CPUS=${CASE_CPUS},CASE_MEMORY_GB=${CASE_MEMORY_GB},UNLIMITED_TRAJECTORIES=${UNLIMITED_TRAJECTORIES},TOLERANCE=${TOLERANCE:-0.005},CONFIDENCE=${CONFIDENCE:-0.95},CALIBRATION_TRAJECTORIES=${CALIBRATION_TRAJECTORIES:-10000},MINIMUM_TRAJECTORIES=${MINIMUM_TRAJECTORIES:-200000},MAXIMUM_TRAJECTORIES=${MAXIMUM_TRAJECTORIES:-64000000},TRAJECTORY_BATCH_SIZE=${TRAJECTORY_BATCH_SIZE:-100000},SAMPLING_MODE=${SAMPLING_MODE:-collision_tube_mixture},TUBE_MIXTURE_FRACTION=${TUBE_MIXTURE_FRACTION:-0.5},MAXIMUM_REFINEMENT_DEPTH=${MAXIMUM_REFINEMENT_DEPTH:-8},MAXIMUM_ENERGY_POINTS=${MAXIMUM_ENERGY_POINTS:-257}"
if [[ -n "${EXTENDED_MAXIMUM_TRAJECTORIES:-}" ]]; then
    next_variables+=",EXTENDED_MAXIMUM_TRAJECTORIES=${EXTENDED_MAXIMUM_TRAJECTORIES}"
fi
next_job="$(qsub \
    -N "nlh_${PROJECTILE}_next" \
    -W "depend=afterok:${dependency}" \
    -v "${next_variables}" \
    "${PBS_DIR}/supervise_adaptive_nlh_particle_shards.pbs")"
echo "Continuation: ${next_job} after ${#array_jobs[@]} array group(s)"
submission_complete=1
