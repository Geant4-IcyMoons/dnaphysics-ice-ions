#!/usr/bin/env bash
#PBS -N soft_dft_smoke
#PBS -q idle
#PBS -l select=1:ncpus=16:mem=160gb
#PBS -l walltime=500:00:00
#PBS -j oe

# Check every registered charge state at one asymptotic ion--H2O geometry.
# This is a runtime/calibration gate, not a molecular table or phase result.

set -euo pipefail
umask 002

if [[ -z "${PROJECTILE:-}" ]]; then
    echo "PROJECTILE must be one of H, He, C, O, or S." >&2
    exit 2
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -d "${PBS_O_WORKDIR}/python_scripts" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "${REPO_ROOT}"

NEP_DIR="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol"
PYTHON_BIN="${PYTHON_BIN:-${NEP_DIR}/.venv/bin/python}"
PREPARE="${NEP_DIR}/prepare_charge_resolved_dft.py"
RUNNER="${NEP_DIR}/run_charge_resolved_dft.py"
CP2K_EXE="${CP2K_EXE:-${REPO_ROOT}/pbs/cp2k_container_wrapper.sh}"
OUTPUT_ROOT="${OUTPUT_ROOT:-${REPO_ROOT}/python_scripts/physics_ice/process_evidence/soft_nuclear_collisions/validation/runs/${PROJECTILE,,}_runtime_smoke}"

if [[ ! -x "${PYTHON_BIN}" || ! -x "${CP2K_EXE}" ]]; then
    echo "Missing Python interpreter or CP2K wrapper." >&2
    exit 2
fi

PREPARE_OUTPUT="$(${PYTHON_BIN} -u "${PREPARE}" \
    --projectile "${PROJECTILE}" --runtime-smoke --output-root "${OUTPUT_ROOT}")"
printf '%s\n' "${PREPARE_OUTPUT}"
MANIFEST="$(printf '%s\n' "${PREPARE_OUTPUT}" | sed -n 's/^Workflow: //p')"
if [[ ! -f "${MANIFEST}" ]]; then
    echo "Preparation did not produce a workflow manifest." >&2
    exit 2
fi

ALLOCATED_CPUS="${PBS_NCPUS:-${NCPUS:-16}}"
# Run one calculation per allocation. The corrected carbon all-charge
# diagonalization gate measured 127.46 GB peak PBS memory; 160 GB retains 25%
# headroom. Revise this request only from successful exact-input accounting.
MPI_RANKS_PER_CALCULATION="${MPI_RANKS_PER_CALCULATION:-16}"
OMP_THREADS_PER_RANK="${OMP_THREADS_PER_RANK:-1}"
if [[ ! "${MPI_RANKS_PER_CALCULATION}" =~ ^[1-9][0-9]*$ \
      || ! "${OMP_THREADS_PER_RANK}" =~ ^[1-9][0-9]*$ ]]; then
    echo "MPI ranks and OpenMP threads must be positive integers." >&2
    exit 2
fi
CPUS_PER_CALCULATION=$((MPI_RANKS_PER_CALCULATION * OMP_THREADS_PER_RANK))
PARALLEL_CALCULATIONS="${PARALLEL_CALCULATIONS:-1}"
if (( CPUS_PER_CALCULATION * PARALLEL_CALCULATIONS > ALLOCATED_CPUS )); then
    echo "CP2K layout exceeds the PBS allocation." >&2
    exit 2
fi

export CP2K_MPI_RANKS="${MPI_RANKS_PER_CALCULATION}"
export OMP_NUM_THREADS="${OMP_THREADS_PER_RANK}"
export CPUS_PER_CALCULATION
export PARALLEL_CALCULATIONS
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

echo "Projectile: ${PROJECTILE}"
echo "Manifest: ${MANIFEST}"
echo "CP2K calculations: ${PARALLEL_CALCULATIONS} concurrent x ${MPI_RANKS_PER_CALCULATION} MPI ranks x ${OMP_THREADS_PER_RANK} threads"
echo "Started UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

pids=()
mapfile -t CPU_GROUPS < <(
    "${PYTHON_BIN}" -c '
import os
cpus = sorted(os.sched_getaffinity(0))
width = int(os.environ["CPUS_PER_CALCULATION"])
count = int(os.environ["PARALLEL_CALCULATIONS"])
if width * count > len(cpus):
    raise SystemExit("Requested CP2K layout exceeds process affinity")
for index in range(count):
    group = cpus[index * width:(index + 1) * width]
    print(",".join(str(cpu) for cpu in group))
'
)
for ((shard=0; shard<PARALLEL_CALCULATIONS; shard++)); do
    taskset -c "${CPU_GROUPS[shard]}" \
        "${PYTHON_BIN}" -u "${RUNNER}" "${MANIFEST}" \
        --shard-count "${PARALLEL_CALCULATIONS}" \
        --shard-index "${shard}" \
        --cp2k-command "${CP2K_EXE}" \
        >"${OUTPUT_ROOT}/shard_${shard}.log" 2>&1 &
    pids+=("$!")
done

failed=0
for pid in "${pids[@]}"; do
    if ! wait "${pid}"; then
        failed=1
    fi
done
if (( failed )); then
    echo "At least one runtime-smoke shard failed; inspect ${OUTPUT_ROOT}." >&2
    exit 1
fi

"${PYTHON_BIN}" -u "${NEP_DIR}/collect_charge_resolved_dft.py" \
    "${MANIFEST}" --require-complete
echo "Completed UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
