#!/usr/bin/env bash
#PBS -N nep_lda_collect
#PBS -q idle
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe

set -euo pipefail
umask 002

REPO_ROOT="${REPO_ROOT:-${PBS_O_WORKDIR}}"
cd "${REPO_ROOT}"
PYTHON="python_scripts/physics_ice/nep_mbpol/.venv/bin/python"
test -x "${PYTHON}"
"${PYTHON}" python_scripts/physics_ice/nep_mbpol/collect_amorphous_density_scan.py
