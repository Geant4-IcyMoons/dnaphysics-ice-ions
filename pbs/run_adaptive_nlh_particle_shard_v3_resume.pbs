#!/usr/bin/env bash
#PBS -N nlh_v3_abs
#PBS -q idle
#PBS -l select=1:ncpus=64:mem=16gb
#PBS -l walltime=500:00:00
#PBS -j oe

# Extend one failed v3 carbon case to the next scheduled look prescribed by the
# predeclared absolute fixed-width audit. The legacy revision supplies
# trajectory physics only; the current audit remains the acceptance authority.

set -euo pipefail
umask 002

LEGACY_COMMIT="${LEGACY_COMMIT:-5f4adfe2585c4707c6d53dba10d580e876e1a688}"
if [[ -z "${AUDIT:-}" || ! -f "${AUDIT}" ]]; then
    echo "AUDIT must name absolute_fixed_width_audit.json." >&2
    exit 2
fi
if [[ -z "${WAVE_MANIFEST:-}" || ! -f "${WAVE_MANIFEST}" ]]; then
    echo "WAVE_MANIFEST must name the existing v3 hard-collision wave." >&2
    exit 2
fi
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    echo "REPO_ROOT or PBS_O_WORKDIR is required." >&2
    exit 2
fi
cd "${REPO_ROOT}"

if ! git cat-file -e "${LEGACY_COMMIT}^{commit}"; then
    echo "Legacy hard-collision revision is unavailable: ${LEGACY_COMMIT}" >&2
    exit 2
fi

FAILED_CASE_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-${FAILED_CASE_INDEX:-}}}"
ALLOCATED_CPUS="${PBS_NCPUS:-${NCPUS:-64}}"
WORKERS="${WORKERS:-${ALLOCATED_CPUS}}"
if [[ ! "${FAILED_CASE_INDEX}" =~ ^[0-9]+$ \
      || ! "${WORKERS}" =~ ^[1-9][0-9]*$ \
      || "${WORKERS}" -gt "${ALLOCATED_CPUS}" ]]; then
    echo "FAILED_CASE_INDEX and WORKERS are invalid." >&2
    exit 2
fi

SCRATCH_PARENT="${TMPDIR:-/tmp}"
SNAPSHOT_ROOT="$(mktemp -d "${SCRATCH_PARENT}/nlh-v3-${PBS_JOBID:-manual}.XXXXXX")"
trap 'rm -rf -- "${SNAPSHOT_ROOT}"' EXIT
git archive "${LEGACY_COMMIT}" python_scripts/physics_ice/nep_mbpol \
    | tar -x -C "${SNAPSHOT_ROOT}"
LEGACY_NEP_ROOT="${SNAPSHOT_ROOT}/python_scripts/physics_ice/nep_mbpol"
RUNNER="${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol/resume_nlh_v3_absolute_fixed_width.py"
PYTHON_BIN="${PYTHON_BIN:-${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol/.venv/bin/python}"
if [[ ! -f "${RUNNER}" || ! -x "${PYTHON_BIN}" ]]; then
    echo "Current continuation runner or audited Python environment is missing." >&2
    exit 2
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

echo "Canonical repository: ${REPO_ROOT}"
echo "Legacy trajectory revision: ${LEGACY_COMMIT}"
echo "Audit: ${AUDIT}"
echo "Wave: ${WAVE_MANIFEST}"
echo "Failed-case index: ${FAILED_CASE_INDEX}; workers: ${WORKERS}"
cmd=("${PYTHON_BIN}" -u "${RUNNER}" \
    "${AUDIT}" "${WAVE_MANIFEST}" "${LEGACY_NEP_ROOT}" \
    --failed-case-index "${FAILED_CASE_INDEX}" \
    --workers "${WORKERS}")
if [[ "${DRY_RUN:-0}" == 1 ]]; then
    cmd+=(--dry-run)
elif [[ "${DRY_RUN:-0}" != 0 ]]; then
    echo "DRY_RUN must be 0 or 1." >&2
    exit 2
fi
"${cmd[@]}"
