#!/usr/bin/env bash
#PBS -N c3_garvey_a
#PBS -q idle
#PBS -l select=1:ncpus=16:mem=16gb
#PBS -l walltime=24:00:00
#PBS -j oe

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/C3_100keVpu.zip" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "${REPO_ROOT}"

CONDA_SH="${CONDA_SH:-/apps01/apps/anaconda3-2022.10/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-yoffe_venv}"
source "${CONDA_SH}"
conda activate "${CONDA_ENV}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
if [[ -n "${TMPDIR:-}" ]]; then
    export NUMBA_CACHE_DIR="${TMPDIR}/ctmc81-garvey-role-cache"
    mkdir -p "${NUMBA_CACHE_DIR}"
fi

python -u \
    python_scripts/physics_ice/process_evidence/charge_exchange_ctmc/benchmarking/run_ctmc81_garvey_role_sensitivity.py \
    --workers "${PBS_NCPUS:-16}" \
    --replicas 2 \
    --trajectories-per-replica 2500 \
    --trajectory-chunk-size 100 \
    --impact-indices 0,1,5,10,15,20,25,30
