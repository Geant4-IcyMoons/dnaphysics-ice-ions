#!/usr/bin/env bash
#PBS -N cp2k_install
#PBS -q idle
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=04:00:00
#PBS -j oe

# Pull the official CP2K 2025.2 MPICH container on a compute node and publish it
# atomically only after its executable and all-electron basis data pass checks.

set -euo pipefail
umask 002

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -d "${PBS_O_WORKDIR}/python_scripts" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi

INSTALL_DIRECTORY="${CP2K_INSTALL_DIRECTORY:-${REPO_ROOT}/software/cp2k}"
IMAGE="${INSTALL_DIRECTORY}/cp2k-2025.2-mpich-x86_64-psmp.sif"
SOURCE="docker://cp2k/cp2k:2025.2_mpich_x86_64_psmp"
CONTAINER_CP2K="/opt/cp2k/bin/cp2k"
mkdir -p "${INSTALL_DIRECTORY}"

if [[ -s "${IMAGE}" ]]; then
    apptainer exec "${IMAGE}" "${CONTAINER_CP2K}" --version
    echo "Existing validated image: ${IMAGE}"
    exit 0
fi

JOB_TAG="${PBS_JOBID:-manual}"
TEMP_IMAGE="${INSTALL_DIRECTORY}/.cp2k-2025.2.${JOB_TAG}.sif"
trap 'rm -f "${TEMP_IMAGE}"' EXIT

echo "Pulling ${SOURCE} to ${TEMP_IMAGE}"
apptainer pull --disable-cache --force "${TEMP_IMAGE}" "${SOURCE}"
apptainer exec "${TEMP_IMAGE}" "${CONTAINER_CP2K}" --version

BASIS_FILE="$(apptainer exec "${TEMP_IMAGE}" sh -lc \
    'find /opt /usr/local -type f -name "BASIS_MOLOPT_UZH" -print -quit 2>/dev/null')"
if [[ -z "${BASIS_FILE}" ]]; then
    echo "CP2K 2025.2 all-electron basis file is absent from the image." >&2
    exit 2
fi
for element in H He C O S; do
    if ! apptainer exec "${TEMP_IMAGE}" awk -v element="${element}" \
        '$1 == element && /TZVPP-MOLOPT-GGA-ae/ {found=1} END {exit !found}' \
        "${BASIS_FILE}"; then
        echo "Missing ${element} TZVPP-MOLOPT-GGA-ae basis." >&2
        exit 2
    fi
done

mv "${TEMP_IMAGE}" "${IMAGE}"
trap - EXIT
echo "Installed and validated: ${IMAGE}"
