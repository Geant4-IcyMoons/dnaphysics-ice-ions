#!/usr/bin/env bash
#PBS -N ctmc_tail
#PBS -q idle
#PBS -l select=1:ncpus=1:mem=1gb
#PBS -l walltime=500:00:00
#PBS -j oe

# Required: ATOM, SOURCE_JOB_IDS, SOURCE_SHARDS, TARGET_SHARDS, OUTPUT_DIR,
# START_SEPARATION_AU, TARGET_BMAX_AU, LOSS_BMAX_AU, and EXTRA_ARGS.
# SOURCE_JOB_IDS and TAIL_QUEUES are semicolon-separated lists.

set -euo pipefail

REPO_ROOT="${REPO_ROOT:-${PBS_O_WORKDIR:?}}"
cd "${REPO_ROOT}"
ATOM="${ATOM:?required}"
SOURCE_JOB_IDS="${SOURCE_JOB_IDS:?required}"
SOURCE_SHARDS="${SOURCE_SHARDS:?required}"
TARGET_SHARDS="${TARGET_SHARDS:?required}"
OUTPUT_DIR="${OUTPUT_DIR:?required}"
START_SEPARATION_AU="${START_SEPARATION_AU:?required}"
TARGET_BMAX_AU="${TARGET_BMAX_AU:?required}"
LOSS_BMAX_AU="${LOSS_BMAX_AU:?required}"
EXTRA_ARGS="${EXTRA_ARGS:?required: exact energy, charge, impact, trajectory, and output settings}"
PYTHON_BIN="${PYTHON_BIN:-python}"
CONDA_SH="${CONDA_SH:-/apps01/apps/anaconda3-2022.10/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-yoffe_venv}"

if [[ -n "${CONDA_ENV}" ]]; then
    # shellcheck disable=SC1090
    source "${CONDA_SH}"
    conda activate "${CONDA_ENV}"
fi

case "${ATOM}" in
    carbon|lithium|oxygen|sulfur) ;;
    *) printf 'Unsupported ATOM=%s\n' "${ATOM}" >&2; exit 2 ;;
esac

supervisor=(
    "${PYTHON_BIN}" -u python_scripts/physics_ice/ctmc_tail_supervisor.py
    --atom "${ATOM}"
    --output-dir "${OUTPUT_DIR}"
    --pbs-script "pbs/generate_${ATOM}_charge_exchange_ctmc.pbs"
    --source-shards "${SOURCE_SHARDS}"
    --target-shards "${TARGET_SHARDS}"
    --array-max "${PBS_ARRAY_MAX:-42}"
    --memory "${SHARD_MEMORY:-8gb}"
    --trigger-fraction "${TAIL_TRIGGER_FRACTION:-0.95}"
    --active-fraction "${TAIL_ACTIVE_FRACTION:-0.25}"
    --poll-seconds "${TAIL_POLL_SECONDS:-300}"
    --freeze-seconds "${TAIL_FREEZE_SECONDS:-180}"
    --max-recovery-attempts "${TAIL_MAX_RECOVERY_ATTEMPTS:-3}"
    --state-file "${OUTPUT_DIR}/${ATOM}_ctmc_tail_supervisor.json"
    --job-name "${ATOM:0:1}_ctmc_tail"
)
IFS=';' read -r -a source_jobs <<< "${SOURCE_JOB_IDS}"
for job in "${source_jobs[@]}"; do
    supervisor+=(--source-job-id "${job}")
done
IFS=';' read -r -a queues <<< "${TAIL_QUEUES:-idle}"
for queue in "${queues[@]}"; do
    supervisor+=(--queue "${queue}")
done

generator=(
    "${PYTHON_BIN}" -u
    "python_scripts/physics_ice/generate_${ATOM}_charge_exchange_ctmc.py"
    --trajectory-chunk-size "${TRAJECTORY_CHUNK_SIZE:-8}"
    --pending-factor "${PENDING_FACTOR:-2}"
    --checkpoint-every "${CHECKPOINT_EVERY:-100}"
    --checkpoint-seconds "${CHECKPOINT_SECONDS:-300}"
    --rtol "${RTOL:-1e-11}"
    --atol "${ATOL:-1e-13}"
    --retry-rtol "${RETRY_RTOL:-1e-12}"
    --retry-atol "${RETRY_ATOL:-1e-14}"
    --maximum-integration-steps "${MAXIMUM_INTEGRATION_STEPS:-100000000}"
    --maximum-relative-energy-drift "${MAXIMUM_RELATIVE_ENERGY_DRIFT:-1e-3}"
    --boundary-extension-factor "${BOUNDARY_EXTENSION_FACTOR:-2}"
    --start-separation-au "${START_SEPARATION_AU}"
    --target-bmax-au "${TARGET_BMAX_AU}"
    --loss-bmax-au "${LOSS_BMAX_AU}"
)
if [[ -n "${MINIMUM_INTEGRATION_TIME_AU:-}" ]]; then
    generator+=(--minimum-integration-time-au "${MINIMUM_INTEGRATION_TIME_AU}")
fi
# EXTRA_ARGS is a trusted administrator/user-provided argument list, matching
# the element PBS wrappers.
# shellcheck disable=SC2206
extra_args=( ${EXTRA_ARGS} )
generator+=("${extra_args[@]}")

printf 'Supervisor command:'
printf ' %q' "${supervisor[@]}" -- "${generator[@]}"
printf '\n'
exec "${supervisor[@]}" -- "${generator[@]}"
