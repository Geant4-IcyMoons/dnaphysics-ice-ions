#!/usr/bin/env bash
#PBS -N zbl_atom_case
#PBS -q idle
#PBS -l select=1:ncpus=64:mem=64gb
#PBS -l walltime=96:00:00
#PBS -j oe

set -euo pipefail
umask 002

if [[ -z "${CAMPAIGN_MANIFEST:-}" || ! -f "${CAMPAIGN_MANIFEST}" ]]; then
    echo "CAMPAIGN_MANIFEST must name a prepared ZBL campaign." >&2
    exit 2
fi
REPO_ROOT="${REPO_ROOT:-${PBS_O_WORKDIR:-}}"
if [[ -z "${REPO_ROOT}" ]]; then
    echo "REPO_ROOT or PBS_O_WORKDIR is required." >&2
    exit 2
fi
cd "${REPO_ROOT}"

LOCAL_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-0}}"
if [[ -n "${CASE_INDEX_FILE:-}" ]]; then
    if [[ ! -f "${CASE_INDEX_FILE}" ]]; then
        echo "CASE_INDEX_FILE does not exist: ${CASE_INDEX_FILE}" >&2
        exit 2
    fi
    CASE_INDEX="$(sed -n "$((LOCAL_INDEX + 1))p" "${CASE_INDEX_FILE}")"
    if [[ ! "${CASE_INDEX}" =~ ^[0-9]+$ ]]; then
        echo "No valid case index mapped for array element ${LOCAL_INDEX}." >&2
        exit 2
    fi
else
    CASE_OFFSET="${CASE_OFFSET:-0}"
    CASE_INDEX=$((LOCAL_INDEX + CASE_OFFSET))
fi
WORKERS="${PBS_NCPUS:-64}"
PYTHON_BIN="${PYTHON_BIN:-${REPO_ROOT}/python_scripts/physics_ice/nep_mbpol/.venv/bin/python}"

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYTHONHASHSEED=0
export PYTHONUNBUFFERED=1

"${PYTHON_BIN}" -u -m \
  python_scripts.physics_ice.process_evidence.soft_nuclear_collisions.zbl.run_campaign \
  run "${CAMPAIGN_MANIFEST}" --case-index "${CASE_INDEX}" --workers "${WORKERS}"
