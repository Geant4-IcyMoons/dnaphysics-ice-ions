#!/usr/bin/env bash
#PBS -N sulfur_ctmc
#PBS -q idle
#PBS -l select=1:ncpus=64:mem=4gb
#PBS -l walltime=500:00:00
#PBS -j oe

# One array element is one independently restartable sulfur compute shard.
# A charge-balanced production layout uses 85 shards (five per charge state)
# split across two PBS arrays:
#
#   qsub -J 0-42 \
#     -v START_SEPARATION_AU,TARGET_BMAX_AU,LOSS_BMAX_AU,SHARD_COUNT=85 \
#     pbs/generate_sulfur_charge_exchange_ctmc.pbs
#   qsub -J 0-41 \
#     -v START_SEPARATION_AU,TARGET_BMAX_AU,LOSS_BMAX_AU,SHARD_COUNT=85,SHARD_OFFSET=43 \
#     pbs/generate_sulfur_charge_exchange_ctmc.pbs
#
# After all 85 elements finish successfully, merge with:
#
#   qsub -l select=1:ncpus=1:mem=4gb \
#     -v START_SEPARATION_AU,TARGET_BMAX_AU,LOSS_BMAX_AU,SHARD_COUNT=85,MERGE_ONLY=1 \
#     pbs/generate_sulfur_charge_exchange_ctmc.pbs
#
# START_SEPARATION_AU requires one value per energy, TARGET_BMAX_AU requires
# five H2O-orbital values, and LOSS_BMAX_AU requires sixteen values for
# S0--S15+. These numerical-domain values must be established by sulfur
# convergence tests before production; this script supplies no ad-hoc default.
# Every shard and the merge must use identical physics/grid arguments.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$(cd "${REPO_ROOT}" && pwd)"
elif [[ -n "${PBS_O_WORKDIR:-}" && -f "${PBS_O_WORKDIR}/python_scripts/physics_ice/generate_sulfur_charge_exchange_ctmc.py" ]]; then
    REPO_ROOT="$(cd "${PBS_O_WORKDIR}" && pwd)"
else
    REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
fi
cd "${REPO_ROOT}"

CONDA_SH="${CONDA_SH:-/apps01/apps/anaconda3-2022.10/etc/profile.d/conda.sh}"
CONDA_ENV="${CONDA_ENV:-yoffe_venv}"
PYTHON_BIN="${PYTHON_BIN:-python}"
SHARD_COUNT="${SHARD_COUNT:-1}"
SHARD_OFFSET="${SHARD_OFFSET:-0}"
ARRAY_INDEX="${PBS_ARRAY_INDEX:-${PBS_ARRAYID:-0}}"
SHARD_INDEX="$((ARRAY_INDEX + SHARD_OFFSET))"
MERGE_ONLY="${MERGE_ONLY:-0}"
ADAPTIVE_ONLY="${ADAPTIVE_ONLY:-0}"
MERGE_ADAPTIVE_ONLY="${MERGE_ADAPTIVE_ONLY:-0}"
TRAJECTORY_CHUNK_SIZE="${TRAJECTORY_CHUNK_SIZE:-8}"
PENDING_FACTOR="${PENDING_FACTOR:-2}"
CHECKPOINT_EVERY="${CHECKPOINT_EVERY:-100}"
CHECKPOINT_SECONDS="${CHECKPOINT_SECONDS:-300}"
RTOL="${RTOL:-1e-11}"
ATOL="${ATOL:-1e-13}"
RETRY_RTOL="${RETRY_RTOL:-1e-12}"
RETRY_ATOL="${RETRY_ATOL:-1e-14}"
MAXIMUM_RELATIVE_ENERGY_DRIFT="${MAXIMUM_RELATIVE_ENERGY_DRIFT:-1e-3}"
BOUNDARY_EXTENSION_FACTOR="${BOUNDARY_EXTENSION_FACTOR:-2}"
ADAPTIVE_AXIS_RELATIVE_TOLERANCE="${ADAPTIVE_AXIS_RELATIVE_TOLERANCE:-0.0025}"
ADAPTIVE_COMBINED_RELATIVE_TOLERANCE="${ADAPTIVE_COMBINED_RELATIVE_TOLERANCE:-0.005}"
ADAPTIVE_STATISTICAL_RELATIVE_TOLERANCE="${ADAPTIVE_STATISTICAL_RELATIVE_TOLERANCE:-0.005}"
ADAPTIVE_STATISTICAL_CONFIDENCE="${ADAPTIVE_STATISTICAL_CONFIDENCE:-0.95}"
ADAPTIVE_MAX_IMPACT_LEVELS="${ADAPTIVE_MAX_IMPACT_LEVELS:-4}"
ADAPTIVE_MAX_ENERGY_LEVELS="${ADAPTIVE_MAX_ENERGY_LEVELS:-4}"
ADAPTIVE_MAX_SAMPLING_LEVELS="${ADAPTIVE_MAX_SAMPLING_LEVELS:-4}"
START_SEPARATION_AU="${START_SEPARATION_AU:?required: one value per selected energy}"
TARGET_BMAX_AU="${TARGET_BMAX_AU:?required: five values for H2O orbitals}"
LOSS_BMAX_AU="${LOSS_BMAX_AU:?required: sixteen values for S0 through S15+}"
MINIMUM_INTEGRATION_TIME_AU="${MINIMUM_INTEGRATION_TIME_AU:-}"

if [[ -n "${CONDA_ENV}" ]]; then
    # shellcheck disable=SC1090
    source "${CONDA_SH}"
    conda activate "${CONDA_ENV}"
fi

if [[ -n "${PBS_NCPUS:-}" ]]; then
    LOCAL_WORKERS="${PBS_NCPUS}"
elif [[ -n "${NCPUS:-}" ]]; then
    LOCAL_WORKERS="${NCPUS}"
else
    LOCAL_WORKERS="$("${PYTHON_BIN}" -c 'import os; print(len(os.sched_getaffinity(0)) if hasattr(os, "sched_getaffinity") else (os.cpu_count() or 1))')"
fi

export OMP_NUM_THREADS=1
export MKL_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
if [[ -n "${TMPDIR:-}" ]]; then
    export NUMBA_CACHE_DIR="${TMPDIR}/sulfur-ctmc-numba-cache"
    mkdir -p "${NUMBA_CACHE_DIR}"
fi

cmd=(
    "${PYTHON_BIN}" -u
    python_scripts/physics_ice/generate_sulfur_charge_exchange_ctmc.py
    --workers "${LOCAL_WORKERS}"
    --trajectory-chunk-size "${TRAJECTORY_CHUNK_SIZE}"
    --pending-factor "${PENDING_FACTOR}"
    --checkpoint-every "${CHECKPOINT_EVERY}"
    --checkpoint-seconds "${CHECKPOINT_SECONDS}"
    --rtol "${RTOL}"
    --atol "${ATOL}"
    --retry-rtol "${RETRY_RTOL}"
    --retry-atol "${RETRY_ATOL}"
    --maximum-relative-energy-drift "${MAXIMUM_RELATIVE_ENERGY_DRIFT}"
    --boundary-extension-factor "${BOUNDARY_EXTENSION_FACTOR}"
    --adaptive-axis-relative-tolerance "${ADAPTIVE_AXIS_RELATIVE_TOLERANCE}"
    --adaptive-combined-relative-tolerance "${ADAPTIVE_COMBINED_RELATIVE_TOLERANCE}"
    --adaptive-statistical-relative-tolerance "${ADAPTIVE_STATISTICAL_RELATIVE_TOLERANCE}"
    --adaptive-statistical-confidence "${ADAPTIVE_STATISTICAL_CONFIDENCE}"
    --adaptive-max-impact-levels "${ADAPTIVE_MAX_IMPACT_LEVELS}"
    --adaptive-max-energy-levels "${ADAPTIVE_MAX_ENERGY_LEVELS}"
    --adaptive-max-sampling-levels "${ADAPTIVE_MAX_SAMPLING_LEVELS}"
    --shard-count "${SHARD_COUNT}"
    --start-separation-au "${START_SEPARATION_AU}"
    --target-bmax-au "${TARGET_BMAX_AU}"
    --loss-bmax-au "${LOSS_BMAX_AU}"
)

if [[ -n "${MINIMUM_INTEGRATION_TIME_AU}" ]]; then
    cmd+=(
        --minimum-integration-time-au
        "${MINIMUM_INTEGRATION_TIME_AU}"
    )
fi

if [[ "${MERGE_ADAPTIVE_ONLY}" == "1" ]]; then
    cmd+=(--merge-adaptive-shards)
elif [[ "${ADAPTIVE_ONLY}" == "1" ]]; then
    cmd+=(--adaptive-only --shard-index "${SHARD_INDEX}")
elif [[ "${MERGE_ONLY}" == "1" ]]; then
    cmd+=(--merge-shards)
else
    cmd+=(--shard-index "${SHARD_INDEX}")
fi

if [[ -n "${EXTRA_ARGS:-}" ]]; then
    # EXTRA_ARGS is intended for trusted, whitespace-separated CLI arguments.
    # shellcheck disable=SC2206
    extra_args=( ${EXTRA_ARGS} )
    cmd+=("${extra_args[@]}")
fi

echo "Repository: ${REPO_ROOT}"
echo "Python: ${PYTHON_BIN} ($(command -v "${PYTHON_BIN}"))"
echo "Conda environment: ${CONDA_ENV}"
echo "Shard: ${SHARD_INDEX}/${SHARD_COUNT}; base merge: ${MERGE_ONLY}; adaptive: ${ADAPTIVE_ONLY}; adaptive merge: ${MERGE_ADAPTIVE_ONLY}"
echo "Local workers: ${LOCAL_WORKERS}; chunk size: ${TRAJECTORY_CHUNK_SIZE}"
echo "DOP853 tolerances: rtol=${RTOL}; atol=${ATOL}"
echo "DOP853 retry tolerances: rtol=${RETRY_RTOL}; atol=${RETRY_ATOL}"
echo "Maximum relative energy drift: ${MAXIMUM_RELATIVE_ENERGY_DRIFT}"
echo "Both-bound boundary extension factor: ${BOUNDARY_EXTENSION_FACTOR}"
printf 'Command:'
printf ' %q' "${cmd[@]}"
printf '\n'

"${cmd[@]}"
