# Verbosity
/tracking/verbose 1
/run/verbose 2
/control/verbose 2
#
# MT
/run/numberOfThreads 1
#
# Material
/dna/test/setMat G4_WATER
# or alternatively
#/dna/test/setMatDens G4_WATER_ICE 0.917 g/cm3
#
# Size of World volume
/dna/test/setSize 100 um
#
# Atomic deexcitation
/process/em/fluo true
/process/em/auger true
/process/em/augerCascade true
/process/em/deexcitationIgnoreCut true
#
# Run initialization
/run/initialize
#
# Visualization
#/control/execute vis.mac
#
# Incident particle type
/gun/particle e-
#
# Particle energy (macro controls it)
/gun/energy 200 eV
#
# Events
/run/beamOn 1
