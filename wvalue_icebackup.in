# Geant4-style W-value scan using dnaphysics-ice custom DNA models.
# Output columns appended to DNA_WVALUE_FILE (default: wvalue_ice.txt):
# E0[eV]  <Nion>  rms(Nion)  w[eV]  w_err[eV]

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/control/alias NEVT 100
/control/alias NEVT_big 10
/control/alias NEVT_huge 5

/control/alias LOG_MODE minimal
# LOG_MODE options:
# - minimal: only step fields needed by depth diagnostics + W-value counting
# - full: full per-step diagnostics (process/model/channel and track ntuple)

# Must be set before /run/initialize
/run/numberOfThreads 12

# Geometry/material for ice model
# Note: keep G4_WATER material while using DNA_PHYSICS=ice_hex or ice_am, as the ICE
# cross-section models are attached via process selection, not material name.
/dna/test/setMat G4_WATER
/dna/test/setIceSize 2000 2000 20000 mm
/dna/test/setLogMode {LOG_MODE}

/run/initialize

# GPS primary definition
/gps/particle e-
/gps/number 1
/gps/pos/type Point
/gps/pos/centre 0 0 100 mm
/gps/direction 0 0 1
/gps/ene/type Mono

/gps/ene/mono 12 eV
/run/beamOn {NEVT}
/gps/ene/mono 15 eV
/run/beamOn {NEVT}
/gps/ene/mono 20 eV
/run/beamOn {NEVT}
/gps/ene/mono 30 eV
/run/beamOn {NEVT}
/gps/ene/mono 40 eV
/run/beamOn {NEVT}
/gps/ene/mono 50 eV
/run/beamOn {NEVT}
/gps/ene/mono 60 eV
/run/beamOn {NEVT}
