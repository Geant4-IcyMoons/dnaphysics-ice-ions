# Proton/alpha ice DCS test macro.
# Select Barkas tables and Dingfelder charge exchange before /run/initialize.

/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0

/dna/test/setLogMode full

/dna/test/setIceSize 100 100 1000 mm
/dna/test/setMatDens G4_WATER_ICE_USER 1. g/cm3
/dna/test/setMat G4_WATER_ICE_USER

/run/initialize
